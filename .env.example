# Copy to `.env.local` for local payment testing (`next dev`).

# Fallback when the server cannot infer the public URL; checkout return URLs prefer the domain you opened in the browser.
# `npm run dev` = port 3000. Dev ke liye: http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Phone/LAN se same machine IP se test: browser jis URL se kholo wahi yahan (warna spinner / redirect odd ho sakta hai). Firebase Console → Authentication → Settings → Authorized domains mein woh host bhi add karo (e.g. 192.168.1.250).
# NEXT_PUBLIC_BASE_URL=http://192.168.1.250:3000
# Static APK / exported shell: Billing page only — payment API hosted URL (same Next app deployed on HTTPS). Empty = same origin.
# NEXT_PUBLIC_BILLING_API_ORIGIN=https://your-app.vercel.app
# Capacitor native Google login: use Firebase Web app OAuth client ID (ends with .apps.googleusercontent.com).
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Stripe — use Test mode Secret key (sk_test_…) from https://dashboard.stripe.com/test/apikeys
# Do not use Restricted keys (rk_…) for server checkout/webhooks unless they include all required permissions.
# Initiate route also reads STRIPE_TEST_SECRET_KEY when Firestore empty (development only).
STRIPE_TEST_SECRET_KEY=

# Webhook route uses STRIPE_SECRET_KEY first; in development falls back to STRIPE_TEST_SECRET_KEY.
STRIPE_SECRET_KEY=
# Developers → Webhooks → endpoint: ${NEXT_PUBLIC_BASE_URL}/api/payments/webhook/stripe → copy signing secret (whsec_…)
STRIPE_WEBHOOK_SECRET=

# Required for /api/payments/webhook/stripe to write payments + upgrade company.planId (Firebase Console → Service accounts).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Khalti — widget public key (sandbox: test_public_key_* from https://test-admin.khalti.com).
# In `next dev`, official sandbox public key applies when Firestore + env are empty (see gateway-keys KHALTI_UAT_PUBLIC_KEY).
KHALTI_TEST_PUBLIC_KEY=test_public_key_dc74e0fd57cb46cd93832aee0a507256
# Server verify after widget pay — secret from same test-admin merchant (not the public key).
KHALTI_TEST_SECRET_KEY=
# Production / shared naming:
# KHALTI_PUBLIC_KEY=
# KHALTI_SECRET_KEY=
# Optional override: KHALTI_VERIFY_URL=https://khalti.com/api/v2/payment/verify/
# Sandbox test wallet: 9800000000, MPIN 1111, OTP 987654

# eSewa Epay v2 (EPAYTEST uses https://rc-epay.esewa.com.np/api/epay/main/v2/form — not uat.esewa.com.np).
# ESEWA_MERCHANT_CODE=EPAYTEST
# ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
# Optional override: ESEWA_EPAY_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
