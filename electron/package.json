{
  "name": "pocket-ledger-electron",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "cd .. && npm run dev",
    "dev:electron": "wait-on http://localhost:3000 && electron .",
    "build:web": "cd .. && npm run build:static",
    "gen-icon": "node scripts/gen-win-icon.mjs",
    "clean-dist": "node scripts/clean-dist.cjs",
    "force-clean": "powershell -ExecutionPolicy Bypass -File scripts/force-clean-dist.ps1",
    "build": "npm run clean-dist && npm run gen-icon && electron-builder --win --projectDir .",
    "build:win": "npm run clean-dist && npm run gen-icon && electron-builder --win --projectDir .",
    "build:win:fast": "npm run gen-icon && electron-builder --win --projectDir .",
    "build:win:alt": "npm run gen-icon && electron-builder --win --projectDir . --config.directories.output=dist-build",
    "build:linux": "electron-builder --linux --projectDir ."
  },
  "build": {
    "appId": "com.pocketledger.desktop",
    "productName": "Pocket Ledger",
    "electronVersion": "41.0.4",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "googleAuthExternal.js",
      "localAppServer.js",
      "localAppServerAccessTokens.js",
      "fetchPublicIpAddress.js",
      "plMirrorProtocol.cjs",
      "plWebPorts.cjs",
      "packagedStaticHeaders.cjs",
      "appUpgradeCache.js",
      "staticAppServer.js",
      "tab-strip.html",
      "tab-strip.js",
      "tab-strip-preload.js",
      "app-content-preload.js",
      {
        "from": "../out",
        "to": "out",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../public",
        "to": ".",
        "filter": [
          "app-icon.png"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "executableName": "Pocket Ledger"
    },
    "nsis": {
      "shortcutName": "Pocket Ledger",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "icon": "../public/app-icon.png"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^41.0.4",
    "electron-builder": "^26.8.1",
    "jimp": "^1.6.1",
    "png-to-ico": "^3.0.1",
    "wait-on": "^9.0.4"
  },
  "dependencies": {
    "serve-handler": "^6.1.7"
  }
}
