
/**
 * Core Philosophy: This ruleset enforces a strict user-ownership model where all data is isolated within a user's own data tree. A user can only read or write documents that are located under their unique user ID path (`/users/{userId}`).
 * Data Structure: All application data is organized hierarchically under the `/users/{userId}` collection. Core user profile data is stored in the user document itself, while related data, such as transactions and categories, are stored in subcollections (`transactions`, `categories`). This structure enables simple, secure, and performant path-based authorization.
 * Key Security Decisions:
 *  - User Enumeration is explicitly disallowed by denying `list` access on the top-level `/users` collection.
 *  - All data is private. There are no public or globally readable collections. Access is only granted if the requesting user's UID matches the `{userId}` in the document path.
 *  - Relational integrity is enforced on create and update operations to ensure that internal ownership fields (e.g., `userId` on a transaction) correctly and immutably link back to the parent user document.
 * Denormalization for Authorization: The hierarchical structure (`/users/{userId}/...`) acts as a form of path-based denormalization. The user's ID is part of the path for all their data, which allows security rules to make authorization decisions without needing to perform extra `get()` calls to other documents.
 * Structural Segregation: The design uses structural segregation by default. Each user's data is entirely contained within their own document tree, providing a strong security boundary between users.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------
    // --- Helper Functions ---
    // ---------------------------

    /**
     * Returns true if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the authenticated user's UID matches the document's owner ID from the path.
     * This is the primary function for enforcing user ownership.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isOneOf(userIds) {
      return isSignedIn() && request.auth.uid in userIds;
    }

    /**
     * A stricter version of isOwner() for update and delete operations.
     * Ensures the document being modified actually exists before applying the ownership check.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * Validates the creation of a new user profile document.
     * Path can be userId (exact uid) or name_uid (e.g. john_abc123); doc must have uid and id == request.auth.uid.
     */
    function isValidUserCreate(userId) {
      return isSignedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.id == request.auth.uid;
    }

    /**
     * Validates an update to a user profile document.
     * Ensures the user is the owner and that the internal 'id' field remains unchanged.
     */
    function canUpdateUser(userId) {
      return isExistingOwner(userId) && request.resource.data.id == resource.data.id;
    }
    // Same-email re-signup: allow update when doc email matches auth email (one doc per email). Path userId is the doc path.
    function canUpdateUserByEmail(userId) {
      return isSignedIn() && userId != null && request.auth.token.email != null && resource.data.email == request.auth.token.email;
    }

    // Presence/heartbeat: user doc may live at path users/slug_uid (e.g. john_abc123). Allow update when doc's id or uid equals auth.uid and id/uid are not changed.
    function canUpdateUserDocByOwnership(userId) {
      return request.auth != null
        && (
          (resource != null && (resource.data.get('id', '') == request.auth.uid || resource.data.get('uid', '') == request.auth.uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['online', 'lastSeen']))
          || (request.auth.uid == userId && resource != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['online', 'lastSeen']))
        );
    }
    // Per-user settings (e.g. Animation & Effects): allow owner to update animationSettings when doc's uid or id matches auth.uid (works for users/slug_uid path).
    function canUpdateOwnAnimationSettings(userId) {
      return isSignedIn() && resource != null
        && (resource.data.get('uid', '') == request.auth.uid || resource.data.get('id', '') == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['animationSettings']);
    }

    /** Admin panel: SuperAdmin dusre user par sirf `role` patch (embedded server-writes toggles hata diye). */
    function canSuperAdminPatchManagedUserFields(userId) {
      return isSuperAdmin() && resource != null
        && request.resource.data.get('id', '') == resource.data.get('id', '')
        && request.resource.data.get('uid', '') == resource.data.get('uid', '')
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['role']);
    }

    /**
     * Validates the creation of a document in a user's subcollection (e.g., transaction, category).
     * Ensures the creator is the owner and the document's internal 'userId' field matches the user's UID.
     */
    function isValidSubcollectionCreate(userId) {
      return isOwner(userId) && request.resource.data.userId == userId;
    }

    /**
     * Validates an update to a subcollection document.
     * Ensures the user is the owner and that the internal 'userId' field is immutable.
     */
    function canUpdateSubcollection(userId) {
      return isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
    }
    
    // Company access: owner (ownerId or ownerEmail) or shared or handover. Subcollections use get(); company doc uses resource.
    // ownerId match is primary. Email compare .lower() — email login / legacy mixed-case ownerEmail.
    function authEmailLower() {
      return request.auth.token.email != null ? request.auth.token.email.lower() : '';
    }
    /** sharedWithEmails array — exact + lowercase token (legacy mixed-case invites). */
    function isEmailInSharedWithEmails(emails) {
      return emails is list && (
        (request.auth.token.email != null && request.auth.token.email in emails) ||
        (authEmailLower() != '' && authEmailLower() in emails)
      );
    }
    /** Normalized lowercase-only array — `array-contains` query + rules align. */
    function isEmailInSharedWithEmailsLower(emails) {
      return emails is list && authEmailLower() != '' && authEmailLower() in emails;
    }
    function hasSharedCompanyAccess(data) {
      return ('sharedWithEmailsLower' in data &&
        isEmailInSharedWithEmailsLower(data.get('sharedWithEmailsLower', []))) ||
        ('sharedWithEmails' in data &&
          isEmailInSharedWithEmails(data.get('sharedWithEmails', [])));
    }
    function isCompanyUser(companyId) {
      let c = get(/databases/$(database)/documents/companies/$(companyId));
      return isSignedIn() && c != null && c.data != null && (
        c.data.get('ownerId', '') == request.auth.uid ||
        (authEmailLower() != '' && c.data.get('ownerEmail', '').lower() == authEmailLower()) ||
        hasSharedCompanyAccess(c.data) ||
        (authEmailLower() != '' && c.data.get('handoverTo', '').lower() == authEmailLower())
      );
    }
    function canReadCompanyData(data) {
      return isAdmin() ||
        data.get('ownerId', '') == request.auth.uid ||
        (authEmailLower() != '' &&
          data.get('ownerEmail', '').lower() == authEmailLower()) ||
        hasSharedCompanyAccess(data) ||
        (authEmailLower() != '' &&
          data.get('handoverTo', '').lower() == authEmailLower());
    }
    function isCompanyOwner(companyId) {
      let c = get(/databases/$(database)/documents/companies/$(companyId));
      return isSignedIn() && c != null && c.data != null && (
        c.data.get('ownerId', '') == request.auth.uid ||
        (authEmailLower() != '' && c.data.get('ownerEmail', '').lower() == authEmailLower())
      );
    }
    /** Shared / handover user — sirf profile fields; owner/plan/share mat badlo */
    function companyMemberProfileUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'address', 'phone', 'email', 'pan', 'country',
          'currencyCode', 'currencySymbol', 'logoUrl',
          'fiscalYearStart', 'fiscalYearEnd', 'adminUsername',
          'encryptServerBackup', 'encryptServerBackupSalt', 'updatedAt'
        ])
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.get('ownerEmail', '') == resource.data.get('ownerEmail', '')
        && request.resource.data.get('planId', '') == resource.data.get('planId', '');
    }

    /**
     * True if the user has admin role (SuperAdmin or CompanyAdmin) for Firestore access (companies, vouchers).
     * Order matters: check hardcoded email + admin_config BEFORE users/{auth.uid} — many profiles live only at
     * users/slug_uid; useAuth mirrors role to users/{uid} but until then superAdminEmails must still grant admin.
     */
    function isAdmin() {
      return isSignedIn() && (
        (authEmailLower() == 'nansari15300@gmail.com')
        || (exists(/databases/$(database)/documents/app_settings/admin_config) &&
            authEmailLower() != '' &&
            (request.auth.token.email in get(/databases/$(database)/documents/app_settings/admin_config).data.get('superAdminEmails', []) ||
             authEmailLower() in get(/databases/$(database)/documents/app_settings/admin_config).data.get('superAdminEmails', [])))
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['SuperAdmin', 'CompanyAdmin'])
      );
    }

    /**
     * Soft-delete / restore / admin-hide recycle markers on `companies/{id}` root.
     * Console + client restore: isDeleted / deletedAt / movedToAdminRecycleAt only.
     */
    function companyRecycleFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['isDeleted', 'deletedAt', 'movedToAdminRecycleAt', 'updatedAt']);
    }
    function canManageCompanyRecycle(companyId) {
      return isCompanyOwner(companyId) || isAdmin() || isSuperAdmin();
    }

    /**
     * SuperAdmin only (not CompanyAdmin) — kisi bhi user ki company / subcollections admin panel se manage karne ke liye.
     * App rules URL nahi dekh sakti; yeh sirf role + email allowlist par based hai (CompanyAdmin ko cross-tenant delete nahi).
     */
    function isSuperAdmin() {
      return isSignedIn() && (
        (authEmailLower() == 'nansari15300@gmail.com')
        || (authEmailLower() == 'nabiullah.ansari@gmail.com')
        || (exists(/databases/$(database)/documents/app_settings/admin_config) &&
            authEmailLower() != '' &&
            (request.auth.token.email in get(/databases/$(database)/documents/app_settings/admin_config).data.get('superAdminEmails', []) ||
             authEmailLower() in get(/databases/$(database)/documents/app_settings/admin_config).data.get('superAdminEmails', [])))
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'SuperAdmin')
      );
    }

    /**
     * Super Admin — collectionGroup / jahan pehle sirf hardcoded email tha; ab admin_config + users role SuperAdmin bhi.
     */
    function isSuperAdminEmail() {
      return isSuperAdmin();
    }

    // ---------------------------
    // --- Collection Rules ---
    // ---------------------------

    /**
     * @description Manages user profile documents.
     * @path /users/{userId}
     * @allow (get, update, delete) A signed-in user (auth.uid='user_abc') accesses their own document at `/users/user_abc`.
     * @allow (create) A new user (auth.uid='user_xyz') creates their own profile document at `/users/user_xyz`.
     * @deny (list) Any user attempting to list all documents in the `/users` collection to prevent user enumeration.
     * @deny (get) A signed-in user (auth.uid='user_abc') attempts to access another user's document at `/users/user_xyz`.
     * @principle Restricts access to a user's own data tree and prevents user data scraping.
     */
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidUserCreate(userId);
      allow update: if canUpdateUser(userId) || canUpdateUserByEmail(userId) || canUpdateUserDocByOwnership(userId) || canUpdateOwnAnimationSettings(userId)
        || canSuperAdminPatchManagedUserFields(userId);
      allow delete: if isExistingOwner(userId);

      /**
       * @description Manages a user's private financial transactions.
       * @path /users/{userId}/transactions/{transactionId}
       * @allow (get, list, create, update, delete) A signed-in user (auth.uid='user_abc') manages their own transaction at `/users/user_abc/transactions/trans_123`.
       * @deny (get) A signed-in user (auth.uid='user_abc') attempts to access a transaction at `/users/user_xyz/transactions/trans_456`.
       * @deny (create) A signed-in user (auth.uid='user_abc') tries to create a transaction under another user's path at `/users/user_xyz/transactions/trans_789`.
       * @principle Enforces path-based ownership for all CRUD and list operations on a user's private subcollection.
       */
      match /transactions/{transactionId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isValidSubcollectionCreate(userId);
        allow update: if canUpdateSubcollection(userId);
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description Manages a user's private spending categories.
       * @path /users/{userId}/categories/{categoryId}
       * @allow (get, list, create, update, delete) A signed-in user (auth.uid='user_abc') manages their own category at `/users/user_abc/categories/cat_123`.
       * @deny (get) A signed-in user (auth.uid='user_abc') attempts to access a category at `/users/user_xyz/categories/cat_456`.
       * @deny (create) A signed-in user (auth.uid='user_abc') tries to create a category with a mismatched internal `userId` field.
       * @principle Enforces path-based ownership and validates relational integrity between the subcollection document and its parent user.
       */
      match /categories/{categoryId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isValidSubcollectionCreate(userId);
        allow update: if canUpdateSubcollection(userId);
        allow delete: if isExistingOwner(userId);
      }
    }
    
    /**
     * @description Manages chat conversations.
     * @path /conversations/{conversationId}
     * @principle Only participants of a conversation can read or write messages.
     */
    match /conversations/{conversationId} {
      // Allow list for signed-in users (where clause filters by participants for security)
      allow list: if isSignedIn();
      // Allow get/create/update/delete only for participants
      allow get, create, update, delete: if isOneOf(conversationId.split('_'));

      match /messages/{messageId} {
        // Allow list for participants (where clause filters results)
        allow list: if isOneOf(conversationId.split('_'));
        allow get: if isOneOf(conversationId.split('_'));
        allow create: if request.auth.uid == request.resource.data.senderId && isOneOf(conversationId.split('_'));
        // Receiver can mark read; any participant can add self to deletedFor for one-side hide.
        allow update: if isOneOf(conversationId.split('_')) && (
          request.auth.uid == resource.data.receiverId ||
          request.auth.uid in request.resource.data.get('deletedFor', [])
        );
        // Sender can always delete; additionally allow hard delete after both participants deleted.
        allow delete: if request.auth.uid == resource.data.senderId ||
          (isOneOf(conversationId.split('_')) &&
            resource.data.get('deletedFor', []).hasAll(conversationId.split('_')));
      }
    }

    /**
     * @description Manages company documents.
     * @path /companies/{companyId}
     * @principle Only company owner or shared users can access company data.
     */
    match /companies/{companyId} {
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid;

      // get by doc id — full membership check
      allow get: if isSignedIn() && canReadCompanyData(resource.data);

      // Collection queries: har branch client `where(...)` se 1:1 align — combined OR ek rule me → shared array-contains permission-denied
      allow list: if isSignedIn() && isAdmin();
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow list: if isSignedIn() && authEmailLower() != ''
        && resource.data.get('ownerEmail', '').lower() == authEmailLower();
      allow list: if isSignedIn() && request.auth.token.email != null
        && request.auth.token.email in resource.data.get('sharedWithEmails', []);
      allow list: if isSignedIn() && authEmailLower() != ''
        && authEmailLower() in resource.data.get('sharedWithEmails', []);
      allow list: if isSignedIn() && authEmailLower() != ''
        && authEmailLower() in resource.data.get('sharedWithEmailsLower', []);
      allow list: if isSignedIn() && authEmailLower() != ''
        && resource.data.get('handoverTo', '').lower() == authEmailLower();

      allow update: if isCompanyOwner(companyId) || isAdmin() || isSuperAdmin();
      // Recycle bin soft-delete / restore / admin-hide — root fields only (permission-denied fix)
      allow update: if canManageCompanyRecycle(companyId) && companyRecycleFieldsOnly();
      // Shared / handover member — Edit Company profile save (name, address, …)
      allow update: if isSignedIn()
        && isCompanyUser(companyId)
        && !isCompanyOwner(companyId)
        && !isAdmin()
        && companyMemberProfileUpdateOnly();
      // Company member — sirf pehli baar khali interCompanyCompanyCode backfill (email/shared login)
      allow update: if isSignedIn()
        && isCompanyUser(companyId)
        && resource.data.get('interCompanyCompanyCode', '') == ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interCompanyCompanyCode']);
      allow delete: if isCompanyOwner(companyId) || isSuperAdmin();

      /**
       * @description Manages vouchers (transactions) for a company.
       * @path /companies/{companyId}/vouchers/{voucherId}
       * collectionGroup("vouchers") hits this path. Check isSuperAdminEmail() first (no get()) so read always allows for that email.
       */
      match /vouchers/{voucherId} {
        allow read: if isSuperAdminEmail() || isAdmin() || isCompanyUser(companyId);
        allow write: if isCompanyUser(companyId) || isSuperAdmin();
      }

      /**
       * Attachment reuse ref-count — voucher "Reuse file" (Firebase Storage URLs).
       * @path /companies/{companyId}/attachment_registry/{registryId}
       */
      match /attachment_registry/{registryId} {
        allow read: if isSuperAdminEmail() || isAdmin() || isCompanyUser(companyId);
        allow write: if isCompanyUser(companyId) || isSuperAdmin();
      }

      /**
       * Outbox flush idempotency: `localVoucherOutbox` `runTransaction` me `companies/{cid}/_pl_ledger_idem/{key}` pe
       * `tx.get` + `tx.set(merge)` — is collection par pehle koi `match` nahi tha → implicit deny → REST BatchGet 403.
       * Access boundary vouchers jaisi: sirf company member / SuperAdmin (shared email `isCompanyUser` me cover).
       * @path /companies/{companyId}/_pl_ledger_idem/{idemKey}
       */
      match /_pl_ledger_idem/{idemKey} {
        allow read: if isSuperAdminEmail() || isAdmin() || isCompanyUser(companyId);
        allow write: if isCompanyUser(companyId) || isSuperAdmin();
      }

      /**
       * Auto Monthly / recurring voucher templates + per-period generation locks (Generate now + app-open runner).
       * Pehle match missing tha — client par "Missing or insufficient permissions" (getDoc / setDoc / transaction).
       * @path /companies/{companyId}/recurring_voucher_templates/{templateId}
       * @path /companies/{companyId}/recurring_voucher_generation_locks/{lockId}
       */
      match /recurring_voucher_templates/{templateId} {
        allow read: if isSuperAdminEmail() || isAdmin() || isCompanyUser(companyId);
        allow write: if isCompanyUser(companyId) || isSuperAdmin();
      }

      match /recurring_voucher_generation_locks/{lockId} {
        allow read: if isSuperAdminEmail() || isAdmin() || isCompanyUser(companyId);
        allow write: if isCompanyUser(companyId) || isSuperAdmin();
      }

      /**
       * Inter Company join settings — shared users same company par auto-sync.
       * @path /companies/{companyId}/inter_company_config/{docId}
       */
      match /inter_company_config/{docId} {
        allow read: if isSuperAdminEmail() || isAdmin() || isCompanyUser(companyId);
        allow write: if isCompanyUser(companyId) || isSuperAdmin();
      }

      /**
       * Share for Reconciliation — company staff mirror of top-level `reconciliation_shares/{shareId}`.
       * Top-level list + isCompanyUser(get) query shared users ke liye aksar fail hoti hai; yahan path-based read.
       * @path /companies/{companyId}/reconciliation_shares/{shareId}
       */
      match /reconciliation_shares/{shareId} {
        allow read, list: if isSuperAdminEmail() || isAdmin() || isCompanyUser(companyId);
        allow create, update, delete: if isCompanyUser(companyId) || isSuperAdmin();
      }
      
      /**
       * @description Manages parties (customers/suppliers) for a company.
       * @path /companies/{companyId}/parties/{partyId}
       */
      match /parties/{partyId} {
        allow read, list: if isCompanyUser(companyId) || isSuperAdmin();
        allow create, update, delete: if isCompanyUser(companyId) || isSuperAdmin();
      }
      
      /**
       * @description Manages party groups for a company.
       * @path /companies/{companyId}/groups/{groupId}
       */
      match /groups/{groupId} {
        allow read, list: if isCompanyUser(companyId) || isSuperAdmin();
        allow create, update, delete: if isCompanyUser(companyId) || isSuperAdmin();
      }
      
      /**
       * @description Manages staff members for a company.
       * @path /companies/{companyId}/staff/{staffId}
       */
      match /staff/{staffId} {
        allow read, list: if isCompanyUser(companyId) || isSuperAdmin();
        allow create, update, delete: if isCompanyUser(companyId) || isSuperAdmin();
      }
      
      /**
       * @description Manages staff groups for a company.
       * @path /companies/{companyId}/staff_groups/{groupId}
       */
      match /staff_groups/{groupId} {
        allow read, list: if isCompanyUser(companyId) || isSuperAdmin();
        allow create, update, delete: if isCompanyUser(companyId) || isSuperAdmin();
      }
      
      /**
       * @description Manages tax accounts for a company.
       * @path /companies/{companyId}/taxes/{taxId}
       */
      match /taxes/{taxId} {
        allow read, list: if isCompanyUser(companyId) || isSuperAdmin();
        allow create, update, delete: if isCompanyUser(companyId) || isSuperAdmin();
      }
      
      /**
       * @description Manages tax groups for a company.
       * @path /companies/{companyId}/tax_groups/{groupId}
       */
      match /tax_groups/{groupId} {
        allow read, list: if isCompanyUser(companyId) || isSuperAdmin();
        allow create, update, delete: if isCompanyUser(companyId) || isSuperAdmin();
      }
      
      /**
       * @description Manages expense accounts for a company.
       * @path /companies/{companyId}/expense_accounts/{accountId}
       */
      match /expense_accounts/{accountId} {
        allow read, list: if isCompanyUser(companyId) || isSuperAdmin();
        allow create, update, delete: if isCompanyUser(companyId) || isSuperAdmin();
      }
      
      /**
       * @description Manages expense groups for a company.
       * @path /companies/{companyId}/expense_groups/{groupId}
       */
      match /expense_groups/{groupId} {
        allow read, list: if isCompanyUser(companyId) || isSuperAdmin();
        allow create, update, delete: if isCompanyUser(companyId) || isSuperAdmin();
      }
      
      /**
       * @description Manages bank and cash accounts for a company.
       * @path /companies/{companyId}/bank_accounts/{accountId}
       */
      match /bank_accounts/{accountId} {
        allow read, list: if isCompanyUser(companyId) || isSuperAdmin();
        allow create, update, delete: if isCompanyUser(companyId) || isSuperAdmin();
      }
      
      /**
       * @description Manages account groups for a company.
       * @path /companies/{companyId}/account_groups/{groupId}
       */
      match /account_groups/{groupId} {
        allow read, list: if isCompanyUser(companyId) || isSuperAdmin();
        allow create, update, delete: if isCompanyUser(companyId) || isSuperAdmin();
      }
      
      /**
       * @description Manages items (inventory) for a company.
       * @path /companies/{companyId}/items/{itemId}
       */
      match /items/{itemId} {
        allow read, list: if isCompanyUser(companyId) || isSuperAdmin();
        allow create, update, delete: if isCompanyUser(companyId) || isSuperAdmin();
      }
      
      /**
       * @description Manages item groups for a company.
       * @path /companies/{companyId}/item_groups/{groupId}
       */
      match /item_groups/{groupId} {
        allow read, list: if isCompanyUser(companyId) || isSuperAdmin();
        allow create, update, delete: if isCompanyUser(companyId) || isSuperAdmin();
      }
      
      /**
       * @description Manages unassigned documents for a company.
       * @path /companies/{companyId}/unassigned_documents/{docId}
       */
      match /unassigned_documents/{docId} {
        allow read, list: if isCompanyUser(companyId) || isSuperAdmin();
        allow create, update, delete: if isCompanyUser(companyId) || isSuperAdmin();
      }
      
      /**
       * @description Manages user presence in a company.
       * @path /companies/{companyId}/presence/{userId}
       */
      match /presence/{userId} {
        allow read: if isCompanyUser(companyId);
        allow write: if request.auth.uid == userId;
      }

      /**
       * @description Manages alarms/notifications for a company.
       * @path /companies/{companyId}/alarms/{alarmId}
       */
      match /alarms/{alarmId} {
        allow read, create, update, delete: if isCompanyUser(companyId) || isSuperAdmin();
      }
      
      /**
       * @description Manages subscription payments for a company.
       * @path /companies/{companyId}/payments/{paymentId}
       * collectionGroup("payments") evaluates each path; SuperAdmin must read without being isCompanyUser — same pattern as vouchers above.
       */
      match /payments/{paymentId} {
        allow read, list: if isSuperAdminEmail() || isAdmin() || isCompanyUser(companyId);
        allow create, update, delete: if isCompanyUser(companyId) || isSuperAdmin();
      }

      /**
       * Device sync & kick-out: owner/admin can delete any device and write logout command.
       * Deploy after edit: firebase deploy --only firestore:rules
       * @path /companies/{companyId}/devices/{deviceId}
       */
      match /devices/{deviceId} {
        allow read, list: if isCompanyUser(companyId) || isSuperAdmin();
        allow create, update: if (isCompanyUser(companyId) && request.resource.data.userId == request.auth.uid) || isSuperAdmin();
        allow delete: if isCompanyOwner(companyId) || isAdmin() || isSuperAdmin()
          || (isCompanyUser(companyId) && resource != null && resource.data.userId == request.auth.uid);
      }

      match /device_commands/{deviceId} {
        allow read, delete: if isCompanyUser(companyId) || isSuperAdmin();
        allow create, update: if isCompanyOwner(companyId) || isAdmin() || isSuperAdmin()
          || (isCompanyUser(companyId) && exists(/databases/$(database)/documents/companies/$(companyId)/devices/$(deviceId))
            && get(/databases/$(database)/documents/companies/$(companyId)/devices/$(deviceId)).data.userId == request.auth.uid);
      }

      /**
       * Device history (log when devices are kicked/removed). Company users can read; owner can create (on kick) and delete.
       * @path /companies/{companyId}/device_history/{entryId}
       */
      match /device_history/{entryId} {
        allow read, list: if isCompanyUser(companyId) || isSuperAdmin();
        allow create: if isCompanyUser(companyId) || isSuperAdmin();
        allow update: if false;
        allow delete: if isCompanyOwner(companyId) || isAdmin() || isSuperAdmin();
      }
    }
    
    /**
     * @description Manages admin notifications.
     * @path /admin_notifications/{notificationId}
     */
    match /admin_notifications/{notificationId} {
      allow create: if isSignedIn();
      // Allow list for signed-in users (where clause filters by recipientUserId)
      allow list: if isSignedIn();
      // Allow get/update/delete only for the recipient
      allow get, update, delete: if request.auth.uid == resource.data.recipientUserId;
    }

    /**
     * Global Inter Company system name registry — duplicate naam block.
     * @path /inter_company_system_names/{nameKey}
     */
    match /inter_company_system_names/{nameKey} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.systemId is string
        && request.resource.data.name is string
        && !exists(/databases/$(database)/documents/inter_company_system_names/$(nameKey));
      allow delete: if isSignedIn()
        && resource.data.ownerUserId == request.auth.uid;
      allow update: if false;
    }

    /**
     * Inter Company groups — owner apni owned companies organize karta hai.
     * @path /inter_company_groups/{groupId}
     */
    match /inter_company_groups/{groupId} {
      allow create: if isSignedIn()
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.nameKey is string
        && request.resource.data.nameKey.size() > 0
        && !exists(/databases/$(database)/documents/inter_company_system_names/$(request.resource.data.nameKey));
      allow read, list: if isSignedIn() && (
        resource.data.ownerUserId == request.auth.uid
        || resource.data.visibility == "public"
      );
      allow update, delete: if isSignedIn()
        && resource.data.ownerUserId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.visibility == "public"
        && request.resource.data.ownerUserId == resource.data.ownerUserId
        && (
          request.resource.data.companyIds.hasAll(resource.data.companyIds)
          || (
            resource.data.companyIds.hasAll(request.resource.data.companyIds)
            && request.resource.data.companyIds.size() + 1 == resource.data.companyIds.size()
            && request.resource.data.get("icLeaveCompanyId", "") is string
            && request.resource.data.icLeaveCompanyId != ""
            && resource.data.companyIds.hasAny([request.resource.data.icLeaveCompanyId])
            && !request.resource.data.companyIds.hasAny([request.resource.data.icLeaveCompanyId])
            && resource.data.get(
              ["companyOwners", request.resource.data.icLeaveCompanyId, "ownerUserId"],
              ""
            ) == request.auth.uid
          )
        );
    }

    /**
     * Inter Com System join requests — visitor asks to join another company in a public system.
     * @path /inter_company_system_join_requests/{requestId}
     */
    match /inter_company_system_join_requests/{requestId} {
      // Doc id: systemId__requesterUid__targetCompanyId — requester hamesha read kar sake
      function joinRequestIdForRequester() {
        return isSignedIn()
          && requestId.matches('.+__' + request.auth.uid + '__.+');
      }
      function joinRequestRowRequester() {
        return isSignedIn()
          && resource.data.get('requesterUserId', '') == request.auth.uid;
      }
      function joinRequestCreateRequester() {
        return isSignedIn()
          && request.resource.data.get('requesterUserId', '') == request.auth.uid
          && request.resource.data.get('status', '') == 'pending';
      }
      function joinRequestTargetOwner() {
        return isSignedIn() && (
          resource.data.get('targetOwnerUserId', '') == request.auth.uid
          || isCompanyOwner(resource.data.get('targetCompanyId', ''))
        );
      }

      allow read, list: if isSignedIn() && (
        joinRequestRowRequester()
        || joinRequestIdForRequester()
        || resource.data.get('systemOwnerUserId', '') == request.auth.uid
        || joinRequestTargetOwner()
      );

      allow create: if joinRequestCreateRequester()
        || (joinRequestIdForRequester()
          && request.resource.data.get('requesterUserId', '') == request.auth.uid
          && request.resource.data.get('status', '') == 'pending');

      allow update: if isSignedIn() && (
        (
          joinRequestTargetOwner()
          || resource.data.get('systemOwnerUserId', '') == request.auth.uid
        )
        && request.resource.data.get('status', '') in ['accepted', 'declined']
        && request.resource.data.get('requesterUserId', '') == resource.data.get('requesterUserId', '')
      )
      || (
        joinRequestRowRequester()
        && resource.data.get('status', '') == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requesterLinkApplied'])
      )
      || (
        joinRequestRowRequester()
        && resource.data.get('status', '') == 'declined'
        && request.resource.data.get('status', '') == 'pending'
      )
      || (
        (joinRequestRowRequester() || joinRequestIdForRequester())
        && request.resource.data.get('requesterUserId', '') == request.auth.uid
        && request.resource.data.get('status', '') == 'pending'
      );

      allow delete: if false;
    }

    /**
     * Public Inter Company company profile — code / PAN / phone sab signed-in users read.
     * Company owner likhta hai jab public system me add / sync karta hai.
     * @path /inter_company_public_profiles/{companyId}
     */
    match /inter_company_public_profiles/{companyId} {
      allow read, list: if isSignedIn();
      allow create, update: if isSignedIn() && isCompanyOwner(companyId);
      allow delete: if isCompanyOwner(companyId) || isAdmin();
    }

    /**
     * User bookmarks for public Inter Company systems (Add to my system).
     * @path /inter_company_public_system_links/{linkId}
     */
    match /inter_company_public_system_links/{linkId} {
      allow read, list: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.systemId is string
        && request.resource.data.systemName is string
        && request.resource.data.ownerUserId is string;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    /**
     * Cross-user Share for Reconciliation — sender / target / receiver read.
     * List queries MUST filter by senderUserId | targetUserId | receiverUserId | senderCompanyId | receiverCompanyId.
     * Company members (sharedWith) may read shares for their company.
     * @path /reconciliation_shares/{shareId}
     */
    match /reconciliation_shares/{shareId} {
      function isReconciliationShareParticipant() {
        return isSignedIn()
          && (
            resource.data.senderUserId == request.auth.uid
            || resource.data.targetUserId == request.auth.uid
            || resource.data.get('receiverUserId', '') == request.auth.uid
          );
      }
      function canReadReconciliationShare() {
        return isReconciliationShareParticipant()
          || (resource.data.get('senderCompanyId', '') != ''
            && isCompanyUser(resource.data.senderCompanyId))
          || (resource.data.get('receiverCompanyId', '') != ''
            && isCompanyUser(resource.data.receiverCompanyId));
      }
      /** Company staff — sirf rowComments + updatedAt (remote row comment save). */
      function reconciliationShareCommentOnlyUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rowComments', 'updatedAt']);
      }
      function canUpdateReconciliationShare() {
        return isReconciliationShareParticipant()
          || (canReadReconciliationShare() && reconciliationShareCommentOnlyUpdate());
      }
      allow get: if canReadReconciliationShare();
      allow list: if canReadReconciliationShare();
      allow create: if isSignedIn()
        && request.resource.data.senderUserId == request.auth.uid
        && request.resource.data.targetUserId is string
        && request.resource.data.senderCompanyId is string
        && request.resource.data.senderAccountId is string;
      allow update: if canUpdateReconciliationShare();
      allow delete: if isSignedIn()
        && resource.data.senderUserId == request.auth.uid;
    }
    
    /**
     * @description Activity logs for admin auditing.
     * @path /activity_logs/{logId}
     */
    match /activity_logs/{logId} {
      allow create: if isSignedIn();
      allow read, list: if isSignedIn();
      allow update, delete: if false;
    }
    
    /**
     * @description Root payments collection (fallback for payment webhooks).
     * @path /payments/{paymentId}
     */
    match /payments/{paymentId} {
      allow read, list, create, update, delete: if isSignedIn();
    }

    /**
     * @description Recycle bin config (quick delete, auto-delete days). Read by all signed-in users (user recycle bin). Written by admin only (enforced by app route).
     * @path /config/recycleBin
     */
    match /config/{docId} {
      allow read, write: if isSignedIn();
    }

    /**
     * @description App-wide settings: features, plans, payment_gateways, admin_config. Any signed-in user can read (sidebar/plans); only isAdmin() may write (admin UI + bootstrap).
     * @path /app_settings/{docId}
     */
    match /app_settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    /**
     * @description Distributor / agent applications (signup). Any signed-in user can create. Applicants can read own; list used by admin (app may use Admin SDK or separate backend for full list).
     * @path /distributor_applications/{applicationId}
     */
    match /distributor_applications/{applicationId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.email == request.auth.token.email);
      allow list: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
