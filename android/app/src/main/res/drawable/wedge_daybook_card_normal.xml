<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Inset so 2dp stroke is not clipped at ListView edges -->

  <item

      android:bottom="1dp"

      android:left="1dp"

      android:right="1dp"

      android:top="1dp">

    <layer-list>

      <item>

        <shape android:shape="rectangle">

          <solid android:color="#FFFFFF" />

          <stroke

              android:width="2dp"

              android:color="#6EE7B7" />

          <corners android:radius="8dp" />

        </shape>

      </item>

      <item android:width="4dp">

        <shape android:shape="rectangle">

          <solid android:color="#6EE7B7" />

          <corners

              android:bottomLeftRadius="8dp"

              android:topLeftRadius="8dp" />

        </shape>

      </item>

    </layer-list>

  </item>

</layer-list>

