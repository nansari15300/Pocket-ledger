<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/wedge_summary_row_line_1dp"
    android:orientation="horizontal"
    android:paddingTop="3dp"
    android:paddingBottom="2dp">

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:text="Total"
        android:textColor="#0F172A"
        android:textSize="8sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wedge_summary_total_open"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:textSize="8sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wedge_summary_total_in"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:textColor="#16A34A"
        android:textSize="8sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wedge_summary_total_out"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:textColor="#DC2626"
        android:textSize="8sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wedge_summary_total_bal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:textSize="8sp"
        android:textStyle="bold" />
</LinearLayout>
