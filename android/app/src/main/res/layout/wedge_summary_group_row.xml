<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wedge_summary_group_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/wedge_summary_row_line_1dp"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/wedge_summary_group_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.4"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="#0F172A"
        android:textSize="8sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wedge_summary_group_open"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:textSize="8sp" />

    <TextView
        android:id="@+id/wedge_summary_group_in"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:textColor="#16A34A"
        android:textSize="8sp" />

    <TextView
        android:id="@+id/wedge_summary_group_out"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:textColor="#DC2626"
        android:textSize="8sp" />

    <TextView
        android:id="@+id/wedge_summary_group_bal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:textSize="8sp" />
</LinearLayout>
