<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"

    android:id="@+id/wedge_daybook_row_root"

    android:layout_width="match_parent"

    android:layout_height="wrap_content"

    android:layout_marginTop="2dp"

    android:layout_marginBottom="6dp"

    android:background="@drawable/wedge_daybook_card_normal"

    android:orientation="vertical"

    android:padding="8dp">



    <LinearLayout

        android:layout_width="match_parent"

        android:layout_height="wrap_content"

        android:orientation="horizontal">



        <TextView

            android:id="@+id/wedge_daybook_row_line1"

            android:layout_width="0dp"

            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:ellipsize="end"

            android:maxLines="1"

            android:textColor="#0F172A"

            android:textSize="11sp"

            android:textStyle="bold" />



        <TextView

            android:id="@+id/wedge_daybook_row_amount"

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:paddingStart="4dp"

            android:textColor="#DC2626"

            android:textSize="11sp"

            android:textStyle="bold" />



        <TextView

            android:id="@+id/wedge_daybook_row_menu"

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:paddingStart="4dp"

            android:text="⋮"

            android:textColor="#64748B"

            android:textSize="14sp"

            android:textStyle="bold" />

    </LinearLayout>



    <TextView

        android:id="@+id/wedge_daybook_row_line2"

        android:layout_width="match_parent"

        android:layout_height="wrap_content"

        android:paddingTop="2dp"

        android:ellipsize="end"

        android:maxLines="2"

        android:textColor="#64748B"

        android:textSize="10sp" />



    <LinearLayout

        android:layout_width="match_parent"

        android:layout_height="wrap_content"

        android:orientation="horizontal"

        android:paddingTop="4dp">



        <TextView

            android:id="@+id/wedge_daybook_row_meta"

            android:layout_width="0dp"

            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:ellipsize="end"

            android:maxLines="1"

            android:textColor="#64748B"

            android:textSize="9sp" />



        <TextView

            android:id="@+id/wedge_daybook_row_balance"

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:background="@drawable/wedge_balance_dr"

            android:paddingStart="4dp"

            android:paddingTop="2dp"

            android:paddingEnd="4dp"

            android:paddingBottom="2dp"

            android:textColor="#16A34A"

            android:textSize="9sp"

            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>

