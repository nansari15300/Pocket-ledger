<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/wedge_summary_row_line_1dp"
    android:orientation="horizontal"
    android:paddingTop="1dp"
    android:paddingBottom="1dp">

    <TextView
        android:id="@+id/wedge_summary_account_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.4"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:singleLine="true"
        android:textColor="#64748B"
        android:textSize="8sp" />

    <TextView
        android:id="@+id/wedge_summary_account_open"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:textSize="8sp" />

    <TextView
        android:id="@+id/wedge_summary_account_in"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:textColor="#16A34A"
        android:textSize="8sp" />

    <TextView
        android:id="@+id/wedge_summary_account_out"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:textColor="#DC2626"
        android:textSize="8sp" />

    <TextView
        android:id="@+id/wedge_summary_account_bal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:textSize="8sp" />
</LinearLayout>
