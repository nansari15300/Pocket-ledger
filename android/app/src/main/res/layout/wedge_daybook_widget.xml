    <FrameLayout android:id="@+id/wedge_daybook_list_frame" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@color/wedge_bg" android:clipChildren="false" android:clipToPadding="false" android:paddingStart="6dp" android:paddingTop="4dp" android:paddingEnd="6dp" android:paddingBottom="6dp">
        <ListView android:id="@+id/wedge_daybook_list" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/wedge_bg" android:clipToPadding="false" android:divider="#00000000" android:dividerHeight="6dp" android:paddingTop="2dp" />
        <TextView android:id="@+id/wedge_daybook_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="12dp" android:text="@string/wedge_daybook_empty" android:textColor="#64748B" android:textSize="12sp" />
    </FrameLayout>
</LinearLayout>
